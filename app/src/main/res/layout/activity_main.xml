<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/layout_container_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_small"
        android:layout_marginTop="@dimen/margin_small"
        app:layout_constraintTop_toTopOf="parent"
        app:cardCornerRadius="@dimen/margin_small">
        <EditText
        android:background="@color/edit_text_background"
            android:padding="@dimen/margin_small"
            android:id="@+id/et_name"
           android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="namn"
            />
    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:id="@+id/layout_container_salary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_small"
        android:layout_marginTop="@dimen/margin_small"
        app:layout_constraintTop_toBottomOf="@id/layout_container_name"
        app:cardCornerRadius="@dimen/margin_small">

    <EditText
        android:padding="@dimen/margin_small"
       android:background="@color/edit_text_background"
        android:id="@+id/et_salary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="salary"

        android:inputType="number"/>
    </androidx.cardview.widget.CardView>

    <Button
        android:layout_marginTop="@dimen/margin_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/greenish"
        android:text="@string/add_button_text"
        app:layout_constraintTop_toBottomOf="@id/layout_container_salary"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:id="@+id/btn_add"/>

    <ListView
        android:layout_marginHorizontal="@dimen/margin_small"
        android:id="@+id/lv_employees"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@color/transparent"
        android:dividerHeight="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_add"
        app:layout_constraintVertical_bias="0"

        tools:listitem="@layout/list_item_employee"


        />

    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/greenish"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:elevation="1dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>